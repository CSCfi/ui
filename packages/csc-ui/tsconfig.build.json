{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // Emit to a dir Vite does NOT manage: `vite build` (and `build:watch`)
    // empties `dist` on every run, which would delete the declarations during
    // dev. `dist-types` survives those rebuilds.
    "outDir": "dist-types",
    "rootDir": "src",
    // The published declarations must not depend on the test toolchain.
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  // Specs and the spec harness are type-checked by tsconfig.json (`type-check`)
  // but must never be emitted into the published `dist-types` (ADR-0049).
  "exclude": ["vite.config.ts", "src/**/*.spec.ts", "src/**/*.spec.d.ts", "src/test/**"]
}
