{
  "name": "@cscfi/csc-ui-next",
  "version": "0.0.1",
  "description": "Vue 3-based replacement for @cscfi/csc-ui — same custom element tag names, Vue v-model contract.",
  "type": "module",
  "main": "./dist/csc-ui-next.js",
  "module": "./dist/csc-ui-next.js",
  "types": "./dist-types/index.d.ts",
  "files": [
    "dist",
    "dist-types"
  ],
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/csc-ui-next.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:watch": "vue-tsc -p tsconfig.build.json && vite build --watch",
    "dev": "vue-tsc -p tsconfig.build.json && vite build --watch",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@oddbird/css-anchor-positioning": "^0.9.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.8.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  },
  "license": "MIT",
  "repository": "CSCfi/ui",
  "homepage": "https://design-system.csc.fi"
}
