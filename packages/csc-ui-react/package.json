{
  "name": "@cscfi/csc-ui-react",
  "version": "4.0.0-alpha.5",
  "description": "React components for the @cscfi/csc-ui custom elements, generated from the Custom Elements Manifest.",
  "author": "My CSC Team <suiteamsui@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@lit/react": "^1.0.8"
  },
  "peerDependencies": {
    "@cscfi/csc-ui": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@cscfi/csc-ui": "workspace:*",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": "CSCfi/ui",
  "homepage": "https://design-system.csc.fi"
}
