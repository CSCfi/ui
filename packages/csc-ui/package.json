{
  "name": "@cscfi/csc-ui",
  "version": "4.0.0-alpha.4",
  "description": "Vue 3-based replacement for @cscfi/csc-ui — same custom element tag names, Vue v-model contract.",
  "type": "module",
  "main": "./dist/csc-ui.js",
  "module": "./dist/csc-ui.js",
  "types": "./dist-types/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "web-types": "./dist/web-types.json",
  "files": [
    "dist",
    "dist-types"
  ],
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/csc-ui.js"
    },
    "./css/*": "./dist/styles/css/*",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "scripts": {
    "build": "pnpm run style-dictionary:build && pnpm run docs:tag-map && vite build && vue-tsc -p tsconfig.build.json && pnpm run docs:manifest:strict",
    "docs:manifest": "node scripts/analyzer/index.mjs",
    "docs:tag-map": "node scripts/analyzer/index.mjs --tag-map",
    "docs:manifest:strict": "node scripts/analyzer/index.mjs --strict",
    "docs:seed": "node scripts/seed-descriptions.mjs",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:watch": "pnpm run style-dictionary:build && vue-tsc -p tsconfig.build.json && vite build --watch",
    "dev": "pnpm run style-dictionary:build && vue-tsc -p tsconfig.build.json && vite build --watch",
    "lint:a11y": "node scripts/check-host-attr-fallthrough.mjs",
    "lint:contrast": "node scripts/audit-contrast.mjs",
    "lint:ramp": "node scripts/check-ramp-parity.mjs",
    "lint:tokens": "node scripts/check-palette-utilities.mjs",
    "style-dictionary:build": "style-dictionary build --config ./style-dictionary.config.cjs",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@oddbird/css-anchor-positioning": "^0.9.0",
    "@tanstack/vue-table": "^8.21.3",
    "culori": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.8.5",
    "style-dictionary": "^3.9.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  },
  "license": "MIT",
  "repository": "CSCfi/ui",
  "homepage": "https://design-system.csc.fi"
}
