{
  "name": "@cscfi/csc-ui-documentation",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site for @cscfi/csc-ui, generated from the library's Custom Elements Manifest.",
  "type": "module",
  "scripts": {
    "build": "pnpm run lint:examples && nuxt build",
    "dev": "nuxt dev",
    "generate": "pnpm run lint:examples && nuxt generate",
    "lint:examples": "node scripts/check-example-parity.mjs",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:viewport": "node scripts/viewport-smoke.mjs"
  },
  "dependencies": {
    "@cscfi/csc-ui": "workspace:*",
    "@mdi/js": "^7.4.47",
    "markdown-it": "^14.1.0",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "catalog:",
    "nuxt": "^4.0.0",
    "playwright": "catalog:",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "catalog:",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5"
  },
  "license": "MIT",
  "repository": "CSCfi/ui"
}
